# Public attribution tag for this Loops entry. It is embedded in transaction
# calldata, so it is not a secret. Copy this file to .env.local.
# The app refuses to broadcast any transaction when ATTRIBUTION_TAG is unset.
# Do not replace this with a code derived from a hostname or another event.
ATTRIBUTION_TAG=celo_6a388b8aedfb

# ONE agent wallet for the whole event. ERC-8004 registration, Textile swaps,
# cNGN payouts, and the receipt all use this key. Create it once, fund it
# yourself, and do not add a second key. Leave blank to run the simulated corridor.
AGENT_PRIVATE_KEY=

# HMAC secret for invoice and receipt links. Set a long random string in production.
INVOICE_SIGNING_SECRET=

# mock (default, no broadcast) | bsc-testnet (Textile sandbox, chain 97) | celo (mainnet)
TEXTILE_MODE=mock

# celo-sepolia (rehearsal) | celo (mainnet, chain 42220)
APP_CHAIN=celo-sepolia

# Optional. A tx_live_ key for Celo, or tx_test_ for BSC testnet only.
# Leave Textile includeAttribution off. The wallet client adds the Loops tag.
TEXTILE_API_KEY=

CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Filled after scripts/deploy-receipt.ts
RECEIPT_REGISTRY=

# Filled after scripts/register-8004.ts. The same agent wallet must be the registrant.
ERC8004_AGENT_ID=

# Public origin used in /agent.json. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
